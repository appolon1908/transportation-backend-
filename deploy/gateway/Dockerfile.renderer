# syntax=docker/dockerfile:1.7
ARG PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 10001 renderer \
    && useradd --system --uid 10001 --gid renderer --home-dir /app renderer

WORKDIR /app
COPY --chown=renderer:renderer deploy/gateway/render_config_v2.py /app/render_config.py
COPY --chown=renderer:renderer deploy/gateway/kong.yml.template /templates/kong.yml.template

USER 10001:10001
ENTRYPOINT ["python", "/app/render_config.py"]
