# Never commit the referenced secret files or replace REDACTED with real values here.
API_DOMAIN=api.codestra.co
FRONTEND_ORIGIN=https://freight.codestra.co
FREIGHT_BACKEND_NETWORK=freight_private

# Production must use immutable image digests.
GATEWAY_RENDERER_IMAGE=ghcr.io/appolon1908-hue/freight-gateway-renderer@sha256:REDACTED
KONG_IMAGE=kong@sha256:REDACTED
CADDY_IMAGE=caddy@sha256:REDACTED
REDIS_IMAGE=redis@sha256:REDACTED

GATEWAY_SHARED_SECRET_FILE=/etc/codestra/secrets/freight-gateway-proof
KONG_REDIS_PASSWORD_FILE=/etc/codestra/secrets/freight-kong-redis-password
KONG_REDIS_DATABASE=0
KONG_LOG_LEVEL=notice
