# Example names and paths only. Never commit real credentials, tokens, or secret files.
# Runtime paths remain unapproved until deploy/runtime/runtime-paths.example.json is
# replaced by an independently reviewed verified-read-only manifest.
ENVIRONMENT=production
APP_VERSION=0.6.0
MIGRATION_HEAD=0005_portal_workflows
FREIGHT_BACKEND_IMAGE=ghcr.io/appolon1908-hue/freight-platform-backend@sha256:REPLACE_WITH_VERIFIED_DIGEST
FREIGHT_BACKEND_NETWORK=REPLACE_WITH_VERIFIED_NETWORK

# Four distinct database identities. The migrator is short-lived; API, ingress,
# and worker identities must be non-superuser NOBYPASSRLS roles.
MIGRATOR_DATABASE_URL=postgresql+asyncpg://freight_migrator:REDACTED@postgres.internal/freight
DATABASE_URL=postgresql+asyncpg://freight_api:REDACTED@postgres.internal/freight
INGRESS_DATABASE_URL=postgresql+asyncpg://freight_ingress:REDACTED@postgres.internal/freight
WORKER_DATABASE_URL=postgresql+asyncpg://freight_worker:REDACTED@postgres.internal/freight

ALLOWED_HOSTS=api.staging.example.invalid
CORS_ORIGINS=https://app.staging.example.invalid
OIDC_ISSUER=https://auth.codestra.co/realms/codestra
OIDC_AUDIENCE=freight-platform-api
OIDC_JWKS_URL=https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs
OIDC_ALLOWED_AZP=freight-platform-portal

INTEGRATION_ALLOWED_HOSTS=n8n.internal.example,odoo.internal.example
INTEGRATION_SECRETS_ENV_FILE=/REPLACE/WITH/VERIFIED/secrets/freight-integrations.env
GATEWAY_SHARED_SECRET_FILE=/REPLACE/WITH/VERIFIED/secrets/freight-gateway-proof
COMPLIANCE_IDENTIFIER_PEPPER_FILE=/REPLACE/WITH/VERIFIED/secrets/freight-compliance-pepper

FORWARDED_ALLOW_IPS=REPLACE_WITH_VERIFIED_GATEWAY_CIDRS
TRUSTED_GATEWAY_CIDRS=REPLACE_WITH_VERIFIED_GATEWAY_CIDRS
INTEGRATION_WORKER_POLL_SECONDS=2
INTEGRATION_FANOUT_BATCH_SIZE=100
INTEGRATION_DELIVERY_BATCH_SIZE=25
INTEGRATION_INBOX_BATCH_SIZE=50

# Explicit fail-closed external-effect defaults.
EXTERNAL_EFFECTS_APPROVED=false
CAPABILITY_LIVE_TENDER_SEND=false
CAPABILITY_LIVE_DISPATCH_NOTIFICATION=false
CAPABILITY_EMAIL_LIVE_SEND=false
CAPABILITY_SMS_LIVE_SEND=false
CAPABILITY_ACCOUNTING_LIVE_EXPORT=false
CAPABILITY_CUSTOMER_PORTAL_EXTERNAL_ACCESS=false
CAPABILITY_CARRIER_PORTAL_EXTERNAL_ACCESS=false
