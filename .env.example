ENVIRONMENT=development
APP_NAME=Freight Platform API
APP_VERSION=0.2.0
DATABASE_URL=postgresql+asyncpg://freight:freight@localhost:5432/freight
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:5173
ENABLE_API_DOCS=true
MAX_REQUEST_BODY_BYTES=10485760

# Required in production. The canonical Keycloak issuer is configured at deploy time.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ALGORITHMS=RS256
OIDC_JWKS_URL=
OIDC_ALLOWED_AZP=
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_JWKS_CACHE_SECONDS=300
OIDC_JWKS_STALE_SECONDS=900
OIDC_HTTP_TIMEOUT_SECONDS=5
ALLOW_DEVELOPMENT_IDENTITY_HEADERS=true

# Legacy tracking webhook remains disabled until a secret is injected.
TRACKING_WEBHOOK_SECRET=

# All live external side effects default off.
CAPABILITY_LIVE_TENDER_SEND=false
CAPABILITY_LIVE_DISPATCH_NOTIFICATION=false
CAPABILITY_EMAIL_LIVE_SEND=false
CAPABILITY_SMS_LIVE_SEND=false
CAPABILITY_ACCOUNTING_LIVE_EXPORT=false
CAPABILITY_CUSTOMER_PORTAL_EXTERNAL_ACCESS=false
CAPABILITY_CARRIER_PORTAL_EXTERNAL_ACCESS=false
EXTERNAL_EFFECTS_APPROVED=false
PRODUCTION_CHANGE_ID=
