# Copy variable names only. Never commit real values.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://api_role:REDACTED@postgres/freight
WORKER_DATABASE_URL=postgresql+asyncpg://integration_worker:REDACTED@postgres/freight
OIDC_ISSUER=https://auth.codestra.co/realms/codestra
OIDC_AUDIENCE=freight-platform-api
OIDC_JWKS_URL=https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs
INTEGRATION_ALLOWED_HOSTS=n8n.internal.codestra.co,odoo.internal.codestra.co
FORWARDED_ALLOW_IPS=10.40.0.1

# Secret-reference targets. Values belong in the deployment secret store.
FREIGHT_N8N_WEBHOOK_SIGNING_KEY=REDACTED
FREIGHT_ODOO_JSON2_API_KEY=REDACTED
FREIGHT_TRACKING_PROVIDER_SIGNING_KEY=REDACTED

WORKER_POLL_SECONDS=2
DELIVERY_CONCURRENCY=8
OUTBOX_FANOUT_BATCH=50
DELIVERY_CLAIM_BATCH=25
INBOUND_CLAIM_BATCH=25
